[Unit]
Description=chd2iso-fuse instance (%i)
After=network-online.target local-fs.target
Wants=network-online.target
Documentation=man:chd2iso-fuse(1)

# Each instance reads its config from /etc/chd2iso-fuse/%i.conf
# Required in the env file:
#   SOURCE=/path/to/chd
#   TARGET=/path/to/iso
# Optional:
#   ALLOW_OTHER=yes|no
#   CD_ALLOW_FORM2=yes|no
#   RECURSIVE=yes|no
#   CACHE_HUNKS=#
#   CACHE_BYTES=#
#   MAX_OPEN_CHDS=#
#   VERBOSE=yes|no

[Service]
Type=simple
EnvironmentFile=-/etc/chd2iso-fuse/%i.conf

# Fail fast if vars missing
ExecStartPre=/bin/sh -c '[ -n "$$SOURCE" ] && [ -n "$$TARGET" ]'
# Create mountpoint if needed
ExecStartPre=/usr/bin/mkdir -p "$$TARGET"

ExecStart=/bin/sh -c '\
  set -eu; \
  set -- chd2iso-fuse --source "$$SOURCE" --mount "$$TARGET"; \
  [ "${ALLOW_OTHER:-no}" = yes ] && set -- "$$@" --allow-other; \
  [ "${CD_ALLOW_FORM2:-no}" = yes ] && set -- "$$@" --cd-allow-form2; \
  [ "${RECURSIVE:-no}" = yes ] && set -- "$$@" --recursive; \
  [ -n "${CACHE_HUNKS:-}" ] && set -- "$$@" --cache-hunks "$$CACHE_HUNKS"; \
  [ -n "${CACHE_BYTES:-}" ] && set -- "$$@" --cache-bytes "$$CACHE_BYTES"; \
  [ -n "${MAX_OPEN_CHDS:-}" ] && set -- "$$@" --max-open-chds "$$MAX_OPEN_CHDS"; \
  [ "${VERBOSE:-no}" = yes ] && set -- "$$@" --verbose; \
  echo "Starting: $$*"; \
  exec "$$@" \
'

ExecStop=/bin/sh -c '/usr/bin/fusermount3 -u "$$TARGET" || /bin/true'

Restart=on-failure
RestartSec=2s
User=root
Group=root
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
